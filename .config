# Ruijie RG-EW3200GX PRO
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_mt7622=y
CONFIG_TARGET_mediatek_mt7622_DEVICE_ruijie_rg-ew3200gx-pro=y

# LuCI with Chinese localization and a responsive theme
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y
# Keep the target's default single libustream SSL provider. The MbedTLS
# variant provides libustream-ssl.so without conflicting with wpad-openssl.
# CONFIG_PACKAGE_libustream-openssl is not set
CONFIG_PACKAGE_libustream-mbedtls=y
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-argon-config-zh-cn=y

# The device profile selects these MT7915 wireless dependencies. Keep them
# explicit so a profile change cannot silently produce an image without Wi-Fi.
CONFIG_PACKAGE_kmod-mt7915e=y
CONFIG_PACKAGE_kmod-mt7915-firmware=y

# Keep the small flash image focused on routing and Wi-Fi.
# CONFIG_PACKAGE_dnsmasq-full is not set
# CONFIG_PACKAGE_bash is not set
# CONFIG_PACKAGE_curl is not set
# CONFIG_PACKAGE_jq is not set
# CONFIG_PACKAGE_ip-full is not set
# CONFIG_PACKAGE_luci-app-homeproxy is not set
# CONFIG_PACKAGE_sing-box is not set
# CONFIG_PACKAGE_mosdns is not set
# CONFIG_PACKAGE_luci-app-mosdns is not set
